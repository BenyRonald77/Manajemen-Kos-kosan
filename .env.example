# Database (PostgreSQL disarankan untuk production, SQLite cukup untuk development lokal)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="ganti-dengan-secret-acak-yang-panjang"

# Timezone (dipakai untuk penjadwalan tagihan bulanan)
APP_TIMEZONE="Asia/Jakarta"

# Konfigurasi tagihan bulanan otomatis
INVOICE_DUE_DAYS=7

# Token rahasia untuk memicu endpoint cron dari scheduler eksternal
# (cron-job.org, GitHub Actions scheduled workflow, dll)
CRON_SECRET="ganti-dengan-token-acak"

# Midtrans (mode sandbox)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
# Sama dengan MIDTRANS_CLIENT_KEY di atas — diekspos ke browser (prefix
# NEXT_PUBLIC_) untuk memuat skrip Snap.js. Client key aman untuk publik.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
